<%- include('../partials/header', { title: 'Login Admin - Medi-Chat' }) %>

<main class="login-wrapper">
  <section class="login-card">
    <h1>Login Admin</h1>
    <p>Masuk untuk mengelola jadwal dokter dan layanan.</p>

    <div id="pesan-error" class="alert alert-error" role="alert" style="display:none;"></div>

    <form id="form-login" novalidate>
      <div class="form-group">
        <label for="username">Username</label>
        <input type="text" id="username" name="username" autocomplete="username" maxlength="50" required>
      </div>

      <div class="form-group">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" autocomplete="current-password" maxlength="128" required>
      </div>

      <button type="submit" id="btn-login" class="btn btn-primary">Masuk</button>
    </form>
  </section>
</main>

<script>
  (function () {
    const form = document.getElementById('form-login');
    const inputUsername = document.getElementById('username');
    const inputPassword = document.getElementById('password');
    const tombol = document.getElementById('btn-login');
    const pesanError = document.getElementById('pesan-error');

    // Pakai textContent supaya pesan tidak dibaca sebagai HTML
    function tampilkanError(teks) {
      pesanError.textContent = teks;
      pesanError.style.display = 'block';
    }

    function sembunyikanError() {
      pesanError.textContent = '';
      pesanError.style.display = 'none';
    }

    // Jika sudah login, langsung ke panel admin
    fetch('/api/admin/me', { credentials: 'same-origin' })
      .then((r) => r.json())
      .then((hasil) => {
        if (hasil && hasil.data && hasil.data.loggedIn) {
          window.location.href = '/admin';
        }
      })
      .catch(() => {});

    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      sembunyikanError();

      const username = inputUsername.value.trim();
      const password = inputPassword.value;

      if (!username || !password) {
        tampilkanError('Username dan password wajib diisi');
        return;
      }

      tombol.disabled = true;
      tombol.textContent = 'Memproses...';

      try {
        const response = await fetch('/api/admin/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          credentials: 'same-origin',
          body: JSON.stringify({ username, password }),
        });
        const hasil = await response.json();

        if (response.ok && hasil.success) {
          window.location.href = '/admin';
          return;
        }
        tampilkanError(hasil.message || 'Login gagal');
      } catch (err) {
        tampilkanError('Tidak dapat terhubung ke server. Coba lagi.');
      }

      tombol.disabled = false;
      tombol.textContent = 'Masuk';
    });
  })();
</script>

<%- include('../partials/footer') %>